# Ningún módulo carga este archivo todavía: hay que exportar las variables a
# mano (`export CORT_LLM_CHAIN=...`) o pasarlas en la línea de orden.
CORT_OLLAMA_URL=http://localhost:11434
CORT_PORT=8765
CORT_CITY_TEMP_C=22

# Cadena de sustitución: habla el primero que responda, en orden.
CORT_LLM_CHAIN=qwen2.5:0.5b,qwen3:0.6b
# No se prueba ningún modelo que pese más que esto en disco. La máquina tiene
# 1,8 GiB; subirlo demasiado la congela.
CORT_LLM_MAX_MODEL_MIB=700
# Segundos por modelo antes de pasar al siguiente de la cadena.
CORT_LLM_TIMEOUT_S=180
CORT_LLM_MAX_TOKENS=120
# Mantiene el modelo en RAM entre turnos. Sin esto cada conversación paga la
# carga completa (113 s medidos frente a 0,9 s con el modelo caliente).
CORT_LLM_KEEP_ALIVE=30m
