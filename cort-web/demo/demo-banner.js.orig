/**
 * Bandeau interactif discret pour la démo en ligne de JARVIS
 * Permet au visiteur de savoir qu'il est en mode aperçu, de tester rapidement des actions,
 * et de télécharger la version Windows ou mobile.
 */
(function () {
  const style = document.createElement("style");
  style.textContent = `
    .jarvis-demo-topbar {
      position: fixed;
      top: 14px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 99999;
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 8px 16px 8px 14px;
      border-radius: 9999px;
      background: rgba(8, 12, 18, 0.88);
      border: 1px solid rgba(34, 211, 238, 0.35);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.8), 0 0 24px -6px rgba(34, 211, 238, 0.3);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      color: #e2e8f0;
      font-size: 11px;
      transition: all 0.3s ease;
    }
    .jarvis-demo-topbar:hover {
      border-color: rgba(34, 211, 238, 0.65);
      box-shadow: 0 12px 35px -8px rgba(34, 211, 238, 0.45);
    }
    .jdt-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 3px 9px;
      border-radius: 9999px;
      background: rgba(34, 211, 238, 0.12);
      border: 1px solid rgba(34, 211, 238, 0.4);
      color: #7dd3fc;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      font-size: 9px;
    }
    .jdt-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #22d3ee;
      box-shadow: 0 0 10px #22d3ee;
      animation: jdtPulse 2s infinite;
    }
    @keyframes jdtPulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.4; transform: scale(0.85); }
    }
    .jdt-text {
      color: #94a3b8;
      display: flex;
      align-items: center;
      gap: 4px;
    }
    .jdt-text strong {
      color: #fff;
    }
    .jdt-actions {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-left: 6px;
    }
    .jdt-btn {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 5px 12px;
      border-radius: 9999px;
      font-size: 10px;
      font-weight: 700;
      text-decoration: none;
      transition: all 0.2s ease;
      cursor: pointer;
      border: none;
    }
    .jdt-btn-primary {
      background: linear-gradient(180deg, #f0fdfa 0%, #a5f3fc 100%);
      color: #04161c;
      box-shadow: 0 4px 14px -3px rgba(34, 211, 238, 0.5);
    }
    .jdt-btn-primary:hover {
      transform: translateY(-1px);
      box-shadow: 0 6px 18px -3px rgba(34, 211, 238, 0.7);
    }
    .jdt-btn-ghost {
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.15);
      color: #cbd5e1;
    }
    .jdt-btn-ghost:hover {
      background: rgba(255, 255, 255, 0.12);
      color: #fff;
      transform: translateY(-1px);
    }
    @media (max-width: 768px) {
      .jarvis-demo-topbar {
        top: 8px;
        width: 94%;
        justify-content: space-between;
        padding: 6px 12px;
      }
      .jdt-text { display: none; }
    }
  `;
  document.head.appendChild(style);

  function createTopBar() {
    const bar = document.createElement("div");
    bar.className = "jarvis-demo-topbar";
    bar.setAttribute("role", "banner");
    bar.innerHTML = `
      <div class="jdt-badge">
        <span class="jdt-dot"></span>
        MODE DÉMO WEB
      </div>
      <div class="jdt-text">
        <span>Testez les <strong>Orbs 3D</strong>, l'interface & les réglages.</span>
      </div>
      <div class="jdt-actions">
        <a href="../pages/jarvis.html#installation" class="jdt-btn jdt-btn-primary">
          Télécharger JARVIS Windows
        </a>
        <a href="https://play.google.com/store/apps/details?id=fr.techenclair.jarvis.mobile" target="_blank" rel="noopener noreferrer" class="jdt-btn jdt-btn-ghost">
          Google Play
        </a>
        <a href="../pages/jarvis.html" class="jdt-btn jdt-btn-ghost" title="Retour au site">
          ✕
        </a>
      </div>
    `;
    document.body.appendChild(bar);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", createTopBar);
  } else {
    createTopBar();
  }
})();
