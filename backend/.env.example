# Copia este archivo como .env y llena lo que tengas (todo es opcional;
# CORT funciona sin ninguna clave en modo comandos-locales + offline).

# Cerebro online (gratis, sin tarjeta):
#   Groq   -> https://console.groq.com/keys      (recomendado, muy rápido)
#   Gemini -> https://aistudio.google.com/apikey
GROQ_API_KEY=
GEMINI_API_KEY=

# Cerebro local (solo en equipos potentes: 8 GB+ RAM y Ollama instalado)
#   ollama pull qwen2.5:3b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# auto | local | online | offline
CORT_MODE=auto
